{
    "name": "pitea-customisation",
    "version": "1.0.0",
    "description": "Custom functionality and modifications for the Pitea WordPress installation",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "watch": "vite build --watch",
        "build:gutenberg": "wp-scripts build source/js/gutenberg/index.js --output-path=dist/gutenberg",
        "watch:gutenberg": "wp-scripts start source/js/gutenberg/index.js --output-path=dist/gutenberg"
    },
    "devDependencies": {
        "@babel/runtime": "^7.28.4",
        "@wordpress/scripts": "^28.0.0",
        "sass": "^1.69.0",
        "vite": "^5.0.0"
    }
}